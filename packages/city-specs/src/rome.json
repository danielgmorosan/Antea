  "sources": [
    {
      "id": "livy-1-6-7",
      "citation": "Livy, Ab Urbe Condita 1.6–7",
      "kind": "later-tradition",
      "licence": "public-domain",
      "note": "Written c. 27 BC about a date traditionally set at 753 BC. Livy himself says the traditions of what happened before the city was founded are poetry rather than record."
    },
    {
      "id": "storey-rome-population",
      "citation": "Glenn R. Storey, “The population of ancient Rome”, Antiquity 71 (1997)",
      "kind": "modern-scholarship",
      "url": "https://www.cambridge.org/core/services/aop-cambridge-core/content/view/BACD7DF32B0B77609CD6713B8AF88882/S0003598X00085859a.pdf/the-population-of-ancient-rome.pdf",
      "note": "Sets out the dispute: “Great Rome” estimates of a million or more against “Little Rome” estimates at or below half a million. Storey argues for roughly 450,000."
    },
    {
      "id": "einhard-vita-karoli",
      "citation": "Einhard, Vita Karoli Magni",
      "kind": "contemporary",
      "licence": "public-domain",
      "note": "Einhard served at Charlemagne's court. His account claims Charlemagne would not have entered St Peter's that day had he known the pope meant to crown him."
    },
    {
      "id": "liber-pontificalis-leo-iii",
      "citation": "Liber Pontificalis, Life of Leo III",
      "kind": "contemporary",
      "licence": "public-domain",
      "note": "The papal account, which credits Leo with the crowning rather than presenting it as a surprise. It and Einhard disagree, and the disagreement is the point."
    }
