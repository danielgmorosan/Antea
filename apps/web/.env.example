# Absolute origin the site is served from. Used for canonical URLs, Open Graph
# tags and the sitemap. Defaults to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=https://antea.example

# Editorial database (Neon, Postgres + PostGIS). Only the migrate CLI and
# server-side code read this; it is never exposed to the browser.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
